# DEVELOPMENT ONLY. Production: python3 infra/install/compose.py
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev@postgres:5432/atlas
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=/api
NEXT_ALLOWED_DEV_ORIGINS=localhost
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=
ATLAS_INSTALL_METHOD=development
# Session lifetime is managed in Atlas System Settings, default 480 minutes.
# First user: run scripts.setup_code reset, then open /setup.
