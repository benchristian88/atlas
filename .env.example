POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev@postgres:5432/atlas
REDIS_URL=redis://redis:6379/0
# Recommended single-origin deployment. The browser uses the current hostname,
# and the operator's reverse proxy sends /api/* to FastAPI unchanged.
NEXT_PUBLIC_API_URL=/api
# Comma-separated hostnames allowed to access the Next.js dev server.
NEXT_ALLOWED_DEV_ORIGINS=localhost
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
# Signed session lifetime in minutes (1-10080).
AUTH_SESSION_MINUTES=480
# Local HTTP only. Production HTTPS deployments must set this to true.
AUTH_COOKIE_SECURE=false
# Only set for intentional split-origin development, for example when the web
# dev server and API are accessed through different browser origins.
CORS_ORIGINS=

# Optional, one-time bootstrap credentials. Atlas reads these only when the
# users table is empty. Use all three together, sign in, change the temporary
# password (minimum 12 characters), then remove them from .env and restart the
# API.
ATLAS_BOOTSTRAP_ADMIN_EMAIL=
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=
ATLAS_BOOTSTRAP_ADMIN_NAME=
