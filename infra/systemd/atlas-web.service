[Unit]
Description=Atlas Impact web UI
After=network-online.target atlas-api.service
Wants=network-online.target atlas-api.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas/apps/web/.next/standalone
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3001
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Next.js may write its image/data cache, never application code.
ReadWritePaths=/opt/atlas/apps/web/.next/standalone/.next/cache

[Install]
WantedBy=multi-user.target
