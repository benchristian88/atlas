[Unit]
Description=Atlas Impact worker boundary
Requires=postgresql.service redis-server.service
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=atlas
Group=atlas
SupplementaryGroups=atlas-runtime-control
WorkingDirectory=/opt/atlas/apps/worker
EnvironmentFile=/etc/atlas/worker.env
Environment=PYTHONPATH=/opt/atlas/apps/api
Environment=ATLAS_STATE_DIR=/var/lib/atlas
ExecStart=/opt/atlas/venv/bin/python -m worker.main
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
