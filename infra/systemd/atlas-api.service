[Unit]
Description=Atlas Impact API
Requires=postgresql.service redis-server.service
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas/apps/api
EnvironmentFile=/etc/atlas/atlas.env
Environment=PATH=/opt/atlas/venv/bin:/usr/bin:/bin
Environment=ATLAS_API_HOST=127.0.0.1
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
Environment=ATLAS_STATE_DIR=/var/lib/atlas
StateDirectory=atlas
StateDirectoryMode=0700
# argv overrides EnvironmentFile values too; the private listener/trust boundary
# cannot be widened accidentally through inherited deployment configuration.
ExecStart=/usr/bin/env ATLAS_API_HOST=127.0.0.1 FORWARDED_ALLOW_IPS=127.0.0.1 /opt/atlas/venv/bin/python -m scripts.start
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
