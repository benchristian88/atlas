{
  "manifest_version": "1.1",
  "id": "proxmox",
  "version": "0.2.2",
  "publisher": {
    "id": "atlas-official",
    "name": "Atlas Impact"
  },
  "display": {
    "name": "Proxmox VE",
    "description": "Read-only Proxmox VE inventory discovery with bounded Network and Interface topology, qualified against Proxmox VE 9.2.11.",
    "category": "virtualization",
    "documentation_uri": "https://github.com/benchristian88/atlas-connectors/tree/main/connectors/proxmox"
  },
  "compatibility": {
    "aip": [
      "1.0"
    ],
    "sdk": {
      "minimum": "1.1.0",
      "exclusive_maximum": "2.0.0"
    },
    "atlas": {
      "minimum": "0.1.0",
      "exclusive_maximum": "1.0.0"
    },
    "runtime": {
      "capability": "integration-runtime-v1",
      "baseline": {
        "minimum": "1.2.0",
        "exclusive_maximum": "2.0.0"
      }
    }
  },
  "source_versions": {
    "qualification": "qualified",
    "qualified_versions": [
      "9.2.11"
    ],
    "known_incompatible": [],
    "newer_untested_policy": "allow_with_warning"
  },
  "capabilities": {
    "test_connection": true,
    "discover": "read_only",
    "scheduling": true,
    "complete_snapshot": true
  },
  "connection_fields": [
    {
      "key": "endpoint",
      "label": "HTTPS endpoint",
      "type": "url",
      "required": true,
      "secret": false,
      "help": "Proxmox HTTPS address, including port 8006 when applicable. Private LAN addresses are supported."
    },
    {
      "key": "token_id",
      "label": "API token ID",
      "type": "secret",
      "required": true,
      "secret": true,
      "validation": {
        "max_length": 255
      },
      "help": "Dedicated API token identity. Password and root login are not supported."
    },
    {
      "key": "token_secret",
      "label": "API token secret",
      "type": "secret",
      "required": true,
      "secret": true,
      "validation": {
        "max_length": 2048
      }
    },
    {
      "key": "tls_policy",
      "label": "TLS policy",
      "type": "enum",
      "required": true,
      "secret": false,
      "options": [
        "verify",
        "fingerprint"
      ],
      "default": "verify",
      "help": "Verified certificates or a trusted SHA-256 certificate fingerprint. Discovery never disables TLS trust."
    },
    {
      "key": "fingerprint",
      "label": "SHA-256 certificate fingerprint",
      "type": "fingerprint",
      "required": true,
      "secret": false,
      "visible_when": {
        "field": "tls_policy",
        "equals": "fingerprint"
      },
      "validation": {
        "min_length": 64,
        "max_length": 95
      },
      "help": "Verify this certificate fingerprint through a trusted channel before entering it."
    }
  ],
  "implementation": {
    "runtime": "ansible",
    "entry_points": {
      "test_connection": "test_connection",
      "discover": "discover"
    },
    "dependencies": [
      {
        "kind": "collection",
        "name": "community.proxmox",
        "version": "2.0.0",
        "digest": "sha256:77e02e0d1e341c6b064900fe58484ad8880cee4832f5fd65d09834ed068216f6",
        "licence": "GPL-3.0-or-later"
      }
    ]
  },
  "licensing": {
    "licence": "Apache-2.0",
    "notices": [
      "NOTICE"
    ],
    "sbom": {
      "format": "SPDX",
      "path": "sbom.spdx.json"
    }
  },
  "object_classes": [
    {
      "key": "proxmox.cluster",
      "kind": "asset",
      "label": "Cluster",
      "required": true,
      "recommended_asset_type_key": "cluster"
    },
    {
      "key": "proxmox.node",
      "kind": "asset",
      "label": "Node",
      "required": true,
      "recommended_asset_type_key": "hypervisor_node"
    },
    {
      "key": "proxmox.qemu",
      "kind": "asset",
      "label": "Qemu",
      "required": true,
      "recommended_asset_type_key": "virtual_machine"
    },
    {
      "key": "proxmox.lxc",
      "kind": "asset",
      "label": "Lxc",
      "required": true,
      "recommended_asset_type_key": "lxc_container"
    },
    {
      "key": "proxmox.network",
      "kind": "network",
      "label": "Network",
      "required": true
    },
    {
      "key": "proxmox.interface",
      "kind": "interface",
      "label": "Interface",
      "required": true
    }
  ],
  "discovery_scopes": [
    {
      "key": "inventory",
      "label": "Deployment inventory and current topology",
      "required": true,
      "default_enabled": true,
      "domains": [
        "assets",
        "networks",
        "interfaces",
        "relationships"
      ],
      "object_classes": [
        "proxmox.cluster",
        "proxmox.node",
        "proxmox.qemu",
        "proxmox.lxc",
        "proxmox.network",
        "proxmox.interface"
      ]
    }
  ],
  "relationship_classes": [
    {
